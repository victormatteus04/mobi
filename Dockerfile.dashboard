FROM mobi/ros2-realsense:humble

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-pip \
      curl \
    && pip3 install --no-cache-dir flask==3.0.* \
    && rm -rf /var/lib/apt/lists/*

COPY dashboard /mobi/dashboard
WORKDIR /mobi/dashboard

CMD ["python3", "app.py"]
