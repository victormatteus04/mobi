# IP deste computador na interface ligada diretamente ao gateway do Mobi.
MOBI_HOST_IP=10.10.10.1

# Porta configurada no cliente rosserial do gateway.
ROSSERIAL_TCP_PORT=11411

# Deve ser igual ao ROS_DOMAIN_ID das demais aplicacoes ROS 2.
ROS_DOMAIN_ID=0

# Prefira /dev/input/by-id para sobreviver a trocas de porta USB.
JOY_DEVICE=/dev/input/js0
# mobi-xbox.config.yaml (Xbox 360) ou mobi-ps4.config.yaml (DualShock 4).
JOY_CONFIG=mobi-xbox.config.yaml

RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Lista separada por virgulas: ouster,d435i,t265,d455
MOBI_SENSOR_SET=ouster,d435i,t265

# Ethernet dedicada do Ouster. Execute ./mobi.sh network uma vez.
OUSTER_INTERFACE=enp2s0
OUSTER_HOSTNAME=169.254.216.20
OUSTER_UDP_DEST=169.254.1.1
OUSTER_LIDAR_MODE=1024x10
OUSTER_TIMESTAMP_MODE=TIME_FROM_ROS_TIME
# "original" inclui tempo por ponto (necessario para deskewing no SLAM).
OUSTER_POINT_TYPE=original

T265_SERIAL=
D435I_SERIAL=
D435I_DEVICE_TYPE=d435i
D435I_PROFILE=640x480x30
D435I_ENABLE_IMU=true
# Desligado por padrao: com mais de uma RealSense USB3 simultanea, os 4
# streams do D435/D455 (color+depth+infra1+infra2) podem estourar a banda/
# negociacao USB e travar o modulo de profundidade.
D435I_ENABLE_INFRA=false
# Idem para o emissor IR: seu pico de corrente derruba o modulo de
# profundidade quando a T265 esta ativa ao mesmo tempo.
D435I_ENABLE_EMITTER=false

D455_SERIAL=
D455_PROFILE=640x480x30
# Desligado por padrao pelo mesmo motivo do D435I_ENABLE_IMU: com mais de uma
# RealSense ativa ao mesmo tempo (aqui, D435i+D455 no mesmo hub USB), o
# modulo de movimento (accel/gyro) da D455 pode falhar por disputa de
# banda/energia ("Motion Module failure").
D455_ENABLE_IMU=false
D455_ENABLE_INFRA=false
D455_ENABLE_EMITTER=false

SENSOR_WAIT_TIMEOUT=60
BAG_MAX_CACHE_SIZE=1073741824
BAG_MAX_SIZE=8589934592

# Porta do painel web (./mobi.sh dashboard).
DASHBOARD_PORT=8080

# Runtime do container de visualizacao (RViz2/rqt). Use "nvidia" se tiver GPU
# NVIDIA + nvidia-container-toolkit instalados (aceleracao 3D real); sem GPU
# dedicada, troque para "runc".
GUI_RUNTIME=nvidia
