<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobi_description</name>
  <version>0.1.0</version>
  <description>
    URDF/xacro do robo Mobi (base + rodas + Ouster + D435i + T265 + D455 + TOFs)
    e o launch que sobe o robot_state_publisher para o TF tree completo.
  </description>
  <maintainer email="victormatteus04@gmail.com">matteus</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
