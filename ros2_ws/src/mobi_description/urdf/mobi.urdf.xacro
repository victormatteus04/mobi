<?xml version="1.0"?>
<!--
  URDF provisorio do Mobi. Medidas e posicoes vieram de estimativa visual do
  robo, nao de desenho tecnico: o objetivo aqui e ter um TF tree completo
  (base_link ate cada sensor) para visualizar os dados no RViz sem quebrar por
  frame ausente. Quando o URDF definitivo chegar, so trocar os valores das
  xacro:property abaixo e as origins dos joints; a estrutura (nomes de link,
  quem e pai de quem) deve continuar valendo.

  Convencao de eixos REP-103: X para frente, Y para a esquerda, Z para cima.
  base_link fica no chao, centrado no retangulo da base (z=0).

  Frames de encaixe dos sensores (nome do link onde cada driver deve raiz
  sua propria arvore de TF):
    - Ouster:  os_sensor  (ouster-ros publica os_sensor para os_lidar / os_imu)
    - D435i:   d435i_link (realsense2_camera publica d435i_link para os demais)
    - T265:    t265_mount -> odom_frame (ver nota abaixo; NAO usar "t265_link"
               como ponto de encaixe: o driver da T265 publica sua propria
               arvore estatica com raiz em "t265_pose_frame", e "t265_link" ja
               e filho dela dentro do driver. O verdadeiro "buraco" livre para
               conectar e "odom_frame": o driver so publica a aresta dinamica
               odom_frame -> t265_pose_frame (a pose do VIO), sem nunca dizer
               quem e o pai de odom_frame. Por isso aqui fechamos
               base_link -> t265_mount -> odom_frame (identidade, assumindo
               que a T265 liga exatamente na pose declarada do mount) e a
               cadeia dinamica do driver encaixa sozinha a partir dai.
    - D455:    d455_link  (mesma logica do D435i, no topo do mastro)
    - TOFs:    tof3d_front_link / tof3d_left_link / tof3d_rear_link /
               tof3d_right_link (confirmado direto no frame_id publicado pela
               ponte ROS1->ROS2, nao e suposicao)
-->
<robot name="mobi" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- dimensoes ajustaveis -->
  <xacro:property name="base_length" value="0.70"/>
  <xacro:property name="base_width"  value="0.50"/>
  <xacro:property name="base_height" value="0.40"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.03"/>
  <xacro:property name="wheel_inset_x" value="0.08"/>
  <xacro:property name="wheel_inset_y" value="0.03"/>

  <xacro:property name="tof_size" value="0.02"/>

  <xacro:property name="ouster_x" value="${base_length/2 - 0.10}"/>
  <xacro:property name="ouster_radius" value="0.045"/>
  <xacro:property name="ouster_height" value="0.07"/>
  <xacro:property name="ouster_standoff" value="0.02"/>

  <xacro:property name="d435i_size" value="0.025 0.09 0.025"/>
  <xacro:property name="t265_size"  value="0.013 0.108 0.025"/>
  <xacro:property name="d455_size" value="0.026 0.124 0.029"/>
  <xacro:property name="camera_face_standoff" value="0.015"/>
  <xacro:property name="camera_z" value="${base_height*0.55}"/>

  <xacro:property name="mast_x" value="0.15"/>
  <xacro:property name="mast_length" value="0.55"/>
  <xacro:property name="mast_radius" value="0.006"/>

  <!-- materiais (so visual) -->
  <material name="mobi_body_gray">
    <color rgba="0.6 0.6 0.62 1.0"/>
  </material>
  <material name="mobi_wheel_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="mobi_sensor_dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="mobi_mast_metal">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>

  <!-- macros -->
  <xacro:macro name="mobi_caster" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
        <material name="mobi_wheel_black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="mobi_tof" params="name x y yaw">
    <link name="${name}">
      <visual>
        <geometry>
          <box size="${tof_size} ${tof_size} ${tof_size}"/>
        </geometry>
        <material name="mobi_sensor_dark"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${camera_z}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <!-- base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="mobi_body_gray"/>
    </visual>
  </link>

  <!-- rodinhas (so visual) -->
  <xacro:mobi_caster name="wheel_front_left"
    x="${base_length/2 - wheel_inset_x}" y="${base_width/2 - wheel_inset_y}"/>
  <xacro:mobi_caster name="wheel_front_right"
    x="${base_length/2 - wheel_inset_x}" y="${-(base_width/2 - wheel_inset_y)}"/>
  <xacro:mobi_caster name="wheel_rear_left"
    x="${-(base_length/2 - wheel_inset_x)}" y="${base_width/2 - wheel_inset_y}"/>
  <xacro:mobi_caster name="wheel_rear_right"
    x="${-(base_length/2 - wheel_inset_x)}" y="${-(base_width/2 - wheel_inset_y)}"/>

  <!-- Ouster (topo, quase na frente) -->
  <link name="os_sensor">
    <visual>
      <origin xyz="0 0 ${ouster_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${ouster_radius}" length="${ouster_height}"/>
      </geometry>
      <material name="mobi_sensor_dark"/>
    </visual>
  </link>
  <joint name="os_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="os_sensor"/>
    <origin xyz="${ouster_x} 0 ${base_height + ouster_standoff}" rpy="0 0 0"/>
  </joint>

  <!-- D435i + T265 (face frontal) -->
  <link name="d435i_link">
    <visual>
      <geometry>
        <box size="${d435i_size}"/>
      </geometry>
      <material name="mobi_sensor_dark"/>
    </visual>
  </link>
  <joint name="d435i_joint" type="fixed">
    <parent link="base_link"/>
    <child link="d435i_link"/>
    <origin xyz="${base_length/2 + camera_face_standoff} -0.06 ${camera_z}" rpy="0 0 0"/>
  </joint>

  <link name="t265_mount">
    <visual>
      <geometry>
        <box size="${t265_size}"/>
      </geometry>
      <material name="mobi_sensor_dark"/>
    </visual>
  </link>
  <joint name="t265_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="t265_mount"/>
    <origin xyz="${base_length/2 + camera_face_standoff} 0.06 ${camera_z}" rpy="0 0 0"/>
  </joint>

  <!-- odom_frame e so uma "tomada": o driver da T265 publica dinamicamente
       odom_frame -> t265_pose_frame -> (t265_link, fisheye, etc). Aqui so
       fechamos base_link -> t265_mount -> odom_frame, sem geometria propria. -->
  <link name="odom_frame"/>
  <joint name="t265_odom_joint" type="fixed">
    <parent link="t265_mount"/>
    <child link="odom_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- mastro + D455 (suspensa do topo) -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 ${mast_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${mast_radius}" length="${mast_length}"/>
      </geometry>
      <material name="mobi_mast_metal"/>
    </visual>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="${mast_x} 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <link name="d455_link">
    <visual>
      <geometry>
        <box size="${d455_size}"/>
      </geometry>
      <material name="mobi_sensor_dark"/>
    </visual>
  </link>
  <joint name="d455_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="d455_link"/>
    <origin xyz="0 0 ${mast_length}" rpy="0 0 0"/>
  </joint>

  <!-- TOFs (uma por face lateral) -->
  <xacro:mobi_tof name="tof3d_front_link" x="${base_length/2}"  y="0" yaw="0"/>
  <xacro:mobi_tof name="tof3d_rear_link"  x="${-base_length/2}" y="0" yaw="${pi}"/>
  <xacro:mobi_tof name="tof3d_left_link"  x="0" y="${base_width/2}"  yaw="${pi/2}"/>
  <xacro:mobi_tof name="tof3d_right_link" x="0" y="${-base_width/2}" yaw="${-pi/2}"/>

</robot>
