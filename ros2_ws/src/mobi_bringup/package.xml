<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobi_bringup</name>
  <version>0.1.0</version>
  <description>
    Launches e parametros do que roda no Mobi: SLAM com o Ouster (RTAB-Map,
    odometria por ICP) e, depois, navegacao (Nav2).
  </description>
  <maintainer email="victormatteus04@gmail.com">matteus</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>mobi_description</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
